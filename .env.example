# Earthdata Login, needed to download NISAR data: free account at https://urs.earthdata.nasa.gov/users/new
# Copy this file to .env (never committed), then fill in EITHER a token (profile > Generate Token) OR username and password.
# Windows, in a terminal opened in the repository folder:  copy .env.example .env  (cmd)
#                                                      or:  Copy-Item .env.example .env  (PowerShell)
# then open it with: notepad .env
# The file must be named exactly .env, not .env.txt (Notepad and Explorer can add a hidden .txt ending).
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# NASA FIRMS fire detections (the fires stage): free map key, sent by email from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
